# Gemini API key — get yours at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend server port (default: 3001)
SERVER_PORT=3001

# Allowed CORS origin for backend (default: Vite dev server)
ALLOWED_ORIGIN=http://localhost:5173

# Admin panel credentials
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_password_here
ADMIN_TOKEN_SECRET=your_random_secret_string_here
